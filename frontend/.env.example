# Copy this file to `.env` and adjust the values for your environment.
# These variables are consumed by the frontend only — no secrets belong here.

# Base URL of the REST API backend.
VITE_API_BASE_URL=http://localhost:8080

# Base URL of the WebSocket server. The WS client appends `/ws/<channel>`
# itself, so do NOT add a trailing `/ws` here.
VITE_WS_BASE_URL=ws://localhost:8080